{
  "rewrites": [
    {
      "source": "/chrono24.xml",
      "destination": "/api/chrono24"
    },
    {
      "source": "/api/katalog.json",
      "destination": "/api/katalog"
    }
  ],
  "headers": [
    {
      "source": "/api/chrono24",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
